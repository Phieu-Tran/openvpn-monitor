# Copy to .env next to docker-compose.yml on the monitor host (.env is not in git).
# `docker compose up -d` after a change.

# The agent on the OpenVPN host.
OVPN_AGENT=http://192.0.2.10:9177

# Red when one session moves more than this per second (up + down); 0 = off.
OVPN_ALERT_RATE=5MB

# History (data/ovpn-dash.db): whichever limit is reached first, the oldest data goes.
OVPN_RETENTION=90d
OVPN_DATA_MAX=5GB
