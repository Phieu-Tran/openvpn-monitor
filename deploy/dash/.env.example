# Copy to .env next to docker-compose.yml on the monitor host (.env is not in git).
# `docker compose up -d` after a change.

# The agent on each OpenVPN host, as name=url, comma-separated; all use data/agent.token.
# The name is stored with the history: pick it once. The first one gets the history of
# dash 0.1.4 and older. One host only: just the URL (the name is then its IP).
OVPN_AGENT=vpn-a=http://192.0.2.10:9177,vpn-b=http://192.0.2.20:9177

# Red when one session moves more than this per second (up + down); 0 = off.
OVPN_ALERT_RATE=5MB

# History (data/ovpn-dash.db): whichever limit is reached first, the oldest data goes.
OVPN_RETENTION=90d
OVPN_DATA_MAX=5GB
