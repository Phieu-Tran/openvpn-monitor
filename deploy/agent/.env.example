# Copy to .env next to docker-compose.yml on the OpenVPN host (.env is not in git).
# `docker compose up -d` after a change.

# This host's LAN IP and port; only the monitor host may reach it (iptables). Never 0.0.0.0.
OVPN_LISTEN=192.0.2.10:9177

# Each profile's data/run directory (the directory, never data/ itself: it holds the PKI).
# One variable per volume line in docker-compose.yml.
OVPN_RUN_PROFILE_A=/path/to/profile-a/data/run
OVPN_RUN_PROFILE_B=/path/to/profile-b/data/run

# Access log (which VPN user opened which IP:port, when): the VPN client subnets of this
# host, from the "server" lines of the profiles. Empty = off. Also uncomment cap_add in docker-compose.yml.
OVPN_FLOWS=
